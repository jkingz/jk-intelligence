# Copy to `.env` and fill in real values. `.env*` stays out of git (RULES.md
# §6): names and placeholders only, never values.
# Server-side names (no NEXT_PUBLIC_ prefix) are read at runtime and never
# reach the client bundle.

# --- Supabase (public: used by browser + server) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# Publishable key (sb_publishable_...); ANON_KEY is the legacy fallback name.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Supabase (server-only) ---
# Service-role key. Required by the repository read path (getAdminDb).
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for db:migrate / db:seed.
SUPABASE_DB_URL=

# --- Queue / cache (server-only) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Preferred over the Upstash pair by lib/queue/syncQueue.ts when set.
REDIS_URL=

# --- Auth / routing ---
# Absolute origin of the app, e.g. http://localhost:3000. Used by the worker
# revalidate loop, Vercel cron bearer checks, and the Playwright baseURL.
NEXT_PUBLIC_APP_URL=
# Bearer secret for /api/cron/sync and /api/revalidate/dashboard (64 chars).
CRON_SECRET=

# --- Demo account (server-only since 2026-09-24 — see Q4) ---
# Read by the auth pages server-side and passed to DemoAccess as props.
# Provision the auth user with `pnpm db:demo-user`. DEMO_CLIENT_ID optionally
# pins which client the demo account links to.
DEMO_EMAIL=
DEMO_PASSWORD=
DEMO_CLIENT_ID=

# --- Integration tier (.env.test) — TEST_ prefixed on purpose ---
# process.loadEnvFile never overrides vars already exported in the shell, so
# reusing a live name would silently point tests at the production project.
# Target the local stack from `supabase start`.
TEST_SUPABASE_URL=http://127.0.0.1:54321
TEST_SUPABASE_PUBLISHABLE_KEY=
TEST_SUPABASE_SERVICE_ROLE_KEY=
TEST_DEMO_PASSWORD=
